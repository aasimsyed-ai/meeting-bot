{
  "name": "@meeting-assistant/desktop",
  "productName": "Meeting Assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Turns any meeting into actionable notes. Works with Teams, Zoom, Google Meet, Slack Huddles and more.",
  "author": "Meeting Assistant",
  "homepage": "https://github.com/aasimsyed-ai/meeting-bot",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "electron-vite build && playwright test",
    "package": "electron-vite build && electron-builder --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@meeting-assistant/core": "workspace:*",
    "electron-updater": "^6.8.9",
    "sherpa-onnx-node": "1.13.8",
    "zod": "^4.1.0"
  },
  "optionalDependencies": {
    "audiotee": "0.0.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^7.3.6"
  }
}
